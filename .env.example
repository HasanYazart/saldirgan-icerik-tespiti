APP_ENV=development
SECRET_KEY=replace-with-at-least-32-random-characters
# python scripts/create_fernet_key.py çıktısını kullanın
DATA_ENCRYPTION_KEY=
DATABASE_URL=sqlite:///./toxic_chat.db
REDIS_URL=
ALLOWED_ORIGINS=http://localhost:8000
ALLOW_REGISTRATION=true
ALLOW_MOCK_MODEL=true
REQUIRE_MODEL_MANIFEST=false
STORE_RAW_MESSAGES=false
MESSAGE_RETENTION_DAYS=30
MAX_MESSAGE_LENGTH=2000
MODERATION_RATE_LIMIT=30
RATE_LIMIT_WINDOW_SECONDS=60
# 0: otomatik ban kapalı; insan incelemesi önerilir
AUTO_BAN_WARNING_COUNT=0
MODEL_DIR=./backend_api
ADMIN_USERNAME=
ADMIN_PASSWORD=
